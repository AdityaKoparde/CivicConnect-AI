// CivicConnect AI — PostgreSQL schema
// UUID primary keys, unique complaint IDs, UTC timestamps, indexed hot paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DEPARTMENT_ADMIN
  DEPARTMENT_OFFICER
  CITIZEN
}

enum ComplaintStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  AWAITING_CITIZEN_INFO
  RESOLVED
  REJECTED
  ESCALATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JurisdictionLevel {
  STATE
  DISTRICT
  TALUK
  LOCAL_BODY
  WARD
}

enum DepartmentType {
  ULB_CORPORATION
  ULB_MUNICIPAL_COUNCIL
  ULB_TOWN_PANCHAYAT
  PWD
  RDPR
  WATER
  POWER
  HEALTH
  FIRE
  TRANSPORT
  POLLUTION
  ANIMAL_WELFARE
  TRIAGE
  OTHER
}

enum UpdateKind {
  STATUS
  ASSIGNMENT
  NOTE
  INFO_REQUEST
  RESOLUTION
  ESCALATION
  DUPLICATE_LINK
}

enum NotificationType {
  COMPLAINT_SUBMITTED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  INFO_REQUESTED
  RESOLVED
  ESCALATED
}

enum ConversationStatus {
  ACTIVE
  CONFIRMED
  ABANDONED
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(CITIZEN)
  phone          String?
  isActive       Boolean   @default(true)
  departmentId   String?   @db.Uuid
  jurisdictionId String?   @db.Uuid
  department     Department? @relation(fields: [departmentId], references: [id])
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  citizen        Citizen?
  notifications  Notification[]
  auditLogs      AuditLog[]
  assignedComplaints Complaint[]        @relation("OfficerAssignments")
  updatesMade    ComplaintUpdate[]
  assignmentsMade Assignment[]         @relation("AssignedBy")
  attachments    Attachment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([departmentId])
  @@index([role])
}

model Citizen {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String?        @unique @db.Uuid
  user              User?          @relation(fields: [userId], references: [id])
  name              String
  phone             String?
  district          String?
  preferredLanguage String         @default("en")
  complaints        Complaint[]
  conversations     Conversation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Department {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique
  name              String
  type              DepartmentType
  description       String?
  categories        String[]
  jurisdictionLevel JurisdictionLevel @default(STATE)
  district          String?
  parentId          String?          @db.Uuid
  parent            Department?      @relation("DeptTree", fields: [parentId], references: [id])
  children          Department[]     @relation("DeptTree")
  contactEmail      String?
  contactWebsite    String?
  isDemo            Boolean          @default(false)
  active            Boolean          @default(true)
  officers          User[]
  complaints        Complaint[]
  assignments       Assignment[]
  escalationRules   EscalationRule[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([district])
  @@index([active])
}

model Jurisdiction {
  id        String           @id @default(uuid()) @db.Uuid
  level     JurisdictionLevel
  name      String
  code      String?
  parentId  String?          @db.Uuid
  parent    Jurisdiction?    @relation("JurTree", fields: [parentId], references: [id])
  children  Jurisdiction[]   @relation("JurTree")
  district  String?
  taluk     String?
  latitude  Float?
  longitude Float?
  isDemo    Boolean          @default(true)
  active    Boolean          @default(true)
  officers  User[]
  complaints Complaint[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([level, district])
  @@index([parentId])
}

model Complaint {
  id                   String           @id @default(uuid()) @db.Uuid
  complaintId          String           @unique
  citizenId            String           @db.Uuid
  citizen              Citizen          @relation(fields: [citizenId], references: [id])
  originalText         String
  normalizedText       String
  summary              String?
  language             String
  category             String
  priority             Priority
  safetyRisk           Boolean          @default(false)
  emergency            Boolean          @default(false)
  status               ComplaintStatus  @default(SUBMITTED)
  district             String?
  taluk                String?
  city                 String?
  ward                 String?
  landmark             String?
  latitude             Float?
  longitude            Float?
  jurisdictionId       String?          @db.Uuid
  jurisdiction         Jurisdiction?    @relation(fields: [jurisdictionId], references: [id])
  departmentId         String?          @db.Uuid
  department           Department?      @relation(fields: [departmentId], references: [id])
  assignedOfficerId    String?          @db.Uuid
  assignedOfficer      User?            @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])
  aiConfidence         Float?
  aiReasoning          String?
  aiProvider           String?
  requiresManualReview Boolean          @default(false)
  routingExplanation   String?
  trackingHash         String
  resolutionNote       String?
  resolvedAt           DateTime?
  duplicateOfId        String?          @db.Uuid
  duplicateOf          Complaint?       @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates           Complaint[]      @relation("Duplicates")
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  updates              ComplaintUpdate[]
  assignments          Assignment[]
  attachments          Attachment[]
  notifications        Notification[]
  conversation         Conversation?

  @@index([status])
  @@index([category])
  @@index([district])
  @@index([departmentId])
  @@index([assignedOfficerId])
  @@index([createdAt])
}

model ComplaintUpdate {
  id          String         @id @default(uuid()) @db.Uuid
  complaintId String         @db.Uuid
  complaint   Complaint      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        UpdateKind
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  note        String?
  isPublic    Boolean        @default(false)
  actorId     String?        @db.Uuid
  actor       User?          @relation(fields: [actorId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([complaintId, createdAt])
}

model Assignment {
  id            String      @id @default(uuid()) @db.Uuid
  complaintId   String      @db.Uuid
  complaint     Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  departmentId  String?     @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id])
  officerId     String?     @db.Uuid
  assignedById  String?     @db.Uuid
  assignedBy    User?       @relation("AssignedBy", fields: [assignedById], references: [id])
  reason        String?
  createdAt     DateTime    @default(now())

  @@index([complaintId, createdAt])
}

model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  filename       String
  mimeType       String
  size           Int
  storagePath    String
  conversationId String?       @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  complaintId    String?       @db.Uuid
  complaint      Complaint?    @relation(fields: [complaintId], references: [id])
  uploadedById   String?       @db.Uuid
  uploadedBy     User?         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([complaintId])
  @@index([conversationId])
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  citizenId   String             @db.Uuid
  citizen     Citizen            @relation(fields: [citizenId], references: [id])
  language    String             @default("en")
  status      ConversationStatus @default(ACTIVE)
  state       Json               @default("{}")
  complaintId String?            @unique @db.Uuid
  complaint   Complaint?         @relation(fields: [complaintId], references: [id])
  messages    Message[]
  attachments Attachment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([citizenId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  language       String?
  meta           Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  complaintId String?          @db.Uuid
  complaint   Complaint?       @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt])
}

model EscalationRule {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  category          String?
  priority          Priority?
  hoursToEscalate   Int
  targetDepartmentId String?    @db.Uuid
  targetDepartment  Department? @relation(fields: [targetDepartmentId], references: [id])
  active            Boolean     @default(true)
  isDemo            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model Category {
  key         String   @id
  label       Json
  description Json     @default("{}")
  icon        String   @default("FileText")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
