# ============================================================
# CivicConnect AI - Root environment template
# Copy to .env (never commit real .env files) and adjust values.
# Each service also has its own .env.example in its folder.
# ============================================================

# ---------- Shared ----------
NODE_ENV=development
# Public origin of the frontend (used for CORS + cookie settings)
FRONTEND_ORIGIN=http://localhost:5173

# ---------- PostgreSQL ----------
# Local dev: portable PostgreSQL runs on 5443 in this workspace.
DATABASE_URL=postgresql://postgres@127.0.0.1:5443/civicconnect?schema=public
# Test database used by the backend test suite
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5443/civicconnect_test?schema=public

# ---------- Backend (Node.js + Express) ----------
BACKEND_PORT=4000
# Secret used to sign JWT session cookies (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
# How long a session cookie lives (seconds). Default 12 hours.
JWT_EXPIRES_IN=43200
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Max upload size in bytes (5 MB)
UPLOAD_MAX_BYTES=5242880
# Directory where complaint attachments are stored
UPLOAD_DIR=uploads

# ---------- AI service (Python + FastAPI) ----------
AI_SERVICE_PORT=8000
# Shared service key: Node.js sends it as X-Service-Key on every AI request
AI_SERVICE_KEY=change-me-shared-internal-key
# AI provider: "demo" (offline rule/ML engine) or "openai" (OpenAI-compatible API)
AI_PROVIDER=demo
# OpenAI-compatible cloud LLM settings (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout in seconds for cloud LLM calls
AI_LLM_TIMEOUT_SECONDS=20
# Route cloud calls through the open-source Respan Gateway (in-process, uses
# your own OPENAI_API_KEY; no account or hosted credits required)
AI_GATEWAY_ENABLED=false
# Optional spare model used when the primary model keeps failing
AI_GATEWAY_FALLBACK_MODEL=

# ---------- Frontend (Vite) ----------
# Backend API base URL as seen by the browser
VITE_API_BASE_URL=http://localhost:4000/api
